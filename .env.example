# ──────────────────────────────────────────────
# Email Alias Generator — Environment Config
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ──────────────────────────────────────────────

# Which provider to use by default: anonaddr | simplelogin
ALIAS_PROVIDER=anonaddr

# ── AnonAddy (addy.io) ──────────────────────
# Get your API key from: https://app.addy.io/settings (API section)
ANONADDR_API_KEY=your_anonaddr_api_key_here

# The domain for your aliases (free tier: anonaddy.me)
# Check available domains at: https://app.addy.io/settings
ANONADDR_DOMAIN=anonaddy.me

# ── SimpleLogin ──────────────────────────────
# Get your API key from: https://app.simplelogin.io/dashboard/api-key
SIMPLELOGIN_API_KEY=your_simplelogin_api_key_here
